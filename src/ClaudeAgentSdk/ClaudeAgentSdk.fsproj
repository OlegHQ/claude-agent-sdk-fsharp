<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Package metadata -->
    <PackageId>ClaudeAgentSdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>snowbear</Authors>
    <Description>Idiomatic F# port of the Claude Agent SDK. Algebraic types, immutability, and functional pipelines.</Description>
    <PackageTags>fsharp;claude;anthropic;ai;sdk;agent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/snowbear/claude-agent-sdk-fsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Transport.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Hooks.fs" />
    <Compile Include="Mcp.fs" />
    <Compile Include="Streaming.fs" />
    <Compile Include="Protocol.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Sdk.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Control.TaskSeq" Version="0.4.*" />
    <PackageReference Include="FsToolkit.ErrorHandling.TaskResult" Version="4.*" />
    <PackageReference Include="Thoth.Json.Net" Version="11.*" />
  </ItemGroup>
</Project>
